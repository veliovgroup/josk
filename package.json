{
  "name": "josk",
  "version": "6.4.1",
  "description": "Tasks/CRON manager for horizontally scaled multi-server applications. Runs on Redis, MongoDB, and PostgreSQL",
  "main": "index.js",
  "type": "module",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "adapters/mongo.js",
    "adapters/mongo.d.ts",
    "adapters/mongo.d.cts",
    "adapters/postgres.js",
    "adapters/postgres.d.ts",
    "adapters/postgres.d.cts",
    "adapters/redis.js",
    "adapters/redis.d.ts",
    "adapters/redis.d.cts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "scripts": {
    "build:types": "rm -rf ./.types-tmp && tsc -p tsconfig.json --outDir ./.types-tmp && node scripts/strip-internal.mjs ./.types-tmp/index.d.ts ./.types-tmp/adapters/redis.d.ts ./.types-tmp/adapters/mongo.d.ts ./.types-tmp/adapters/postgres.d.ts ./.types-tmp/adapters/blank-example.d.ts && node scripts/cjs-types.mjs ./.types-tmp/index.d.ts ./.types-tmp/adapters/redis.d.ts ./.types-tmp/adapters/mongo.d.ts ./.types-tmp/adapters/postgres.d.ts && cp ./.types-tmp/index.d.ts ./.types-tmp/index.d.cts ./ && cp ./.types-tmp/adapters/*.d.ts ./.types-tmp/adapters/*.d.cts ./adapters/ && rm -rf ./.types-tmp",
    "prepublishOnly": "rollup index.js --file index.cjs --format cjs --external crypto,node:crypto --generatedCode.constBindings && npm run build:types",
    "lint": "eslint .",
    "test": "npm run lint && mocha ./test/npm.js && npm run test:jest && npm run test:types",
    "test:adapter-guards": "mocha ./test/adapter-guards.js",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:jest:core": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/jest/core.test.js",
    "test:jest:adapters": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/jest/adapters.test.js",
    "test:bun": "bun test ./test/jest/core.test.js ./test/jest/adapters.test.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs --coverage",
    "test:types": "tsc -p ./tsconfig.types.json && node ./test/types/packed.mjs",
    "test:redis": "mocha ./test/npm-redis.js",
    "test:mongo": "mocha ./test/npm-mongo.js ./test/mongo-url.test.js ./test/mongo-lock-index.js ./test/mongo-task-index.js",
    "test:postgres": "mocha ./test/npm-postgres.js"
  },
  "keywords": [
    "agenda",
    "bun",
    "cluster",
    "CRON",
    "cron-jobs",
    "distributed",
    "highload",
    "horizontal scaling",
    "job",
    "jobs",
    "meteor",
    "mongo",
    "mongodb",
    "pg",
    "postgres",
    "postgresql",
    "redis",
    "schedule",
    "scheduler",
    "setInterval",
    "setTimeout",
    "task",
    "task manager",
    "task scheduler",
    "tasks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veliovgroup/josk.git"
  },
  "bugs": {
    "url": "https://github.com/veliovgroup/josk/issues"
  },
  "homepage": "https://github.com/veliovgroup/josk",
  "author": "dr.dimitru (https://veliovgroup.com)",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=14.21.3",
    "bun": ">=1.1.0"
  },
  "meteor": {
    "packageName": "ostrio:cron-jobs",
    "versionsFrom": [
      "2.14",
      "3.2"
    ],
    "node": {
      "2.14": ">=14",
      "3.2": ">=18"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "chai": "^6.2.2",
    "cron-parser": "^5.5.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "josk5": "npm:josk@5.0.0",
    "mocha": "^11.7.5",
    "mongodb": "^7.2.0",
    "mongodb5": "npm:mongodb@^5.9.2",
    "mongodb6": "npm:mongodb@^6.21.0",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "redis4": "npm:redis@^4.7.1",
    "rollup": "^4.60.4",
    "typescript": "^6.0.3"
  }
}
